~ start
if Gs.day == 1
	=> meeting_1
else
	%3 => meeting
	%2 => nothing
=> END

~ meeting_1
do Gs._stop()
Narrator: You should meet your new colleagues
set Gs.event = "1_meeting"
do Gs._play()
=> END

~ meeting
do Gs._stop()
Narrator: You need go to leaving room
set Gs.event = "meeting"
do Gs._play()
=> END

~ nothing
do Gs._stop()
Narrator: Today nothing to do
set Gs.event = ""
do Gs._play()
=> END