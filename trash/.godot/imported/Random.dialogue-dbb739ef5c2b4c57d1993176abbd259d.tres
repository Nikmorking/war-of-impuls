"character_replacements": Array[Dictionary]([]),
"id": "101",
"next_id": "102",
"notes": "",
"tags": PackedStringArray(),
"text": "Where's the director?",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Where's the director?",
"type": &"dialogue"
},
"102": {
"character": "Richard",
"character_replacements": Array[Dictionary]([]),
"id": "102",
"next_id": "103",
"notes": "",
"tags": PackedStringArray(),
"text": "How should I know?",
"text_replacements": Array[Dictionary]([]),
"translation_key": "How should I know?",
"type": &"dialogue"
},
"103": {
"character": "Deputy director",
"character_replacements": Array[Dictionary]([]),
"id": "103",
"next_id": "104",
"notes": "",
"tags": PackedStringArray(),
"text": "He went to another city on business.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "He went to another city on business.",
"type": &"dialogue"
},
"104": {
"character": "The guard",
"character_replacements": Array[Dictionary]([]),
"id": "104",
"next_id": "105",
"notes": "",
"tags": PackedStringArray(),
"text": "That's why we don't have a single penny in our office. I'll run to look for him!*",
"text_replacements": Array[Dictionary]([]),
"translation_key": "That's why we don't have a single penny in our office. I'll run to look for him!*",
"type": &"dialogue"
},
"105": {
"character": "the methodologist runs away",
"character_replacements": Array[Dictionary]([]),
"id": "105",
"next_id": "106",
"notes": "",
"tags": PackedStringArray(),
"text": "The director is a bastard! He stole everything and left!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "The director is a bastard! He stole everything and left!",
"type": &"dialogue"
},
"106": {
"character": "Secretary",
"character_replacements": Array[Dictionary]([]),
"id": "106",
"next_id": "107",
"notes": "",
"tags": PackedStringArray(),
"text": "You're a brute!  The last scum!  It's not enough to kill!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "You're a brute!  The last scum!  It's not enough to kill!",
"type": &"dialogue"
},
"107": {
"character": "Manager",
"character_replacements": Array[Dictionary]([]),
"id": "107",
"next_id": "108",
"notes": "",
"tags": PackedStringArray(),
"text": "No one is allowed to leave the premises! If he comes back, we'll tie him up and hand him over!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "No one is allowed to leave the premises! If he comes back, we'll tie him up and hand him over!",
"type": &"dialogue"
},
"108": {
"character": "Janitor",
"character_replacements": Array[Dictionary]([]),
"id": "108",
"next_id": "109",
"notes": "",
"tags": PackedStringArray(),
"text": "I'm going to kill this thing with my own hands!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "I'm going to kill this thing with my own hands!",
"type": &"dialogue"
},
"109": {
"character": "analyst",
"character_replacements": Array[Dictionary]([]),
"id": "109",
"next_id": "110",
"notes": "",
"tags": PackedStringArray(),
"text": "I'll tear it up on the spot!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "I'll tear it up on the spot!",
"type": &"dialogue"
},
"11": {
"character": "Narrator",
"character_replacements": Array[Dictionary]([]),
"id": "11",
"next_id": "12",
"notes": "",
"tags": PackedStringArray(),
"text": "You should meet your new colleagues",
"text_replacements": Array[Dictionary]([]),
"translation_key": "You should meet your new colleagues",
"type": &"dialogue"
},
"110": {
"character": "Accountant",
"character_replacements": Array[Dictionary]([]),
"id": "110",
"next_id": "111",
"notes": "",
"tags": PackedStringArray(),
"text": "I won't let you bury him!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "I won't let you bury him!",
"type": &"dialogue"
},
"111": {
"character": "Economist",
"character_replacements": Array[Dictionary]([]),
"id": "111",
"next_id": "112",
"notes": "",
"tags": PackedStringArray(),
"text": "I'll destroy him and scatter his ashes!",
"text_replacements": Array[Dictionary]([]),
"translation_key": "I'll destroy him and scatter his ashes!",
"type": &"dialogue"
},
"112": {
"character": "Director",
"character_replacements": Array[Dictionary]([]),
"id": "112",
"next_id": "113",
"notes": "",
"tags": PackedStringArray(),
"text": "* enters from the toilet * Guys, where's the money? Where's the guard? Why are you so angry?",
"text_replacements": Array[Dictionary]([]),
"translation_key": "* enters from the toilet * Guys, where's the money? Where's the guard? Why are you so angry?",
"type": &"dialogue"
},
"113": {
"character": "Richard",
"character_replacements": Array[Dictionary]([]),
"id": "113",
"next_id": "114",
"notes": "",
"tags": PackedStringArray(),
"text": "A security guard? He's gone to look for you...",
"text_replacements": Array[Dictionary]([]),
"translation_key": "A security guard? He's gone to look for you...",
"type": &"dialogue"
},
"114": {
"character": "director",
"character_replacements": Array[Dictionary]([]),
"id": "114",
"next_id": "115",
"notes": "",
"tags": PackedStringArray(),
"text": "Why are you looking for me? I decided to go to the bathroom on the way ...",
"text_replacements": Array[Dictionary]([]),
"translation_key": "Why are you looking for me? I decided to go to the bathroom on the way ...",
"type": &"dialogue"
},
"115": {
"character": "",
"character_replacements": Array[Dictionary]([]),
"id": "115",
"next_id": "116",
"notes": "",
"tags": PackedStringArray(),
