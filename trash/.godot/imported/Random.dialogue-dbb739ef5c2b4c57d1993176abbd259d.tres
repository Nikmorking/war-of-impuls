},
"125": {
"character": "employee",
"character_replacements": Array[Dictionary]([]),
"id": "125",
"next_id": "126",
"notes": "",
"tags": PackedStringArray(),
"text": "What is it? Have the dinosaurs escaped again? Have the aliens stopped trading again?",
