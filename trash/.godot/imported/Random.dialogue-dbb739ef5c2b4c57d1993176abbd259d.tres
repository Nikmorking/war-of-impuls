"translation_key": "I won't give it to you, you remember. Next!",
"type": &"dialogue"
},
"142": {
"character": "Methodologist",
"character_replacements": Array[Dictionary]([]),
"id": "142",
"next_id": "143",
"notes": "",
"tags": PackedStringArray(),
"text": "You can pay...",
"text_replacements": Array[Dictionary]([]),
"translation_key": "You can pay...",
"type": &"dialogue"
},
"143": {
"character": "manager",
"character_replacements": Array[Dictionary]([]),
"id": "143",
"next_id": "144",
"notes": "",
"tags": PackedStringArray(),
"text": "It's not fair! I honestly worked for 4 years without a salary, without days off and without delays! Give me a salary.",
"text_replacements": Array[Dictionary]([]),
"translation_key": "It's not fair! I honestly worked for 4 years without a salary, without days off and without delays! Give me a salary.",
"type": &"dialogue"
},
"144": {
